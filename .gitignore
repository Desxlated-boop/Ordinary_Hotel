# Dependency directories
node_modules/
jspm_packages/
web_stage/

# Build and distribution directories
dist/
build/
client/dist/
server/dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Runtime data / dynamic user uploads
server/uploads/*
!server/uploads/.gitkeep

# Operating System Files
.DS_Store
Thumbs.db

# IDE and Editor Files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local environment files (contains passwords, API keys, secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
client/.env
server/.env
*.env.local

# Keep env examples tracked
!.env.example
!client/.env.example
!server/.env.example
